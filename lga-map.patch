index 0000000..8287bc4
--- /dev/null
+++ b/superset-frontend/plugins/plugin-chart-echarts/src/LgaMap/transformProps.ts
@@ -0,0 +1,344 @@
+/**
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+import {
+  DataRecord,
+  getColumnLabel,
+  getMetricLabel,
+  getNumberFormatter,
+  getSequentialSchemeRegistry,
+} from '@superset-ui/core';
+import { registerMap } from 'echarts/core';
+import type { EChartsCoreOption } from 'echarts/core';
+import {
+  DEFAULT_FORM_DATA,
+  EchartsLgaMapChartProps,
+  LgaMapChartTransformedProps,
+} from './types';
+import {
+  extractGroupbyLabel,
+  getColtypesMapping,
+  sanitizeHtml,
+} from '../utils/series';
+import { Refs } from '../types';
+
+const FALLBACK_COLORS = ['#e8f5e9', '#a5d6a7', '#66bb6a', '#2e7d32', '#1b5e20'];
+
+// DHIS2 names carry a two-letter prefix ("ta Karim-Lamido") and a suffix
+// ("Local Government Area" / "State"); the map shows the plain name.
+function cleanName(raw: string): string {
+  return raw
+    .replace(/^[a-z]{2}\s+/, '')
+    .replace(/\s+(Local Government Area|State)$/i, '')
+    .trim();
+}
+
+type GeoFeature = {
+  type: 'Feature';
+  properties: { name: string };
+  geometry: unknown;
+};
+
+type RGB = [number, number, number];
+
+function parseGeometry(raw: unknown): unknown | null {
+  if (!raw) return null;
+  if (typeof raw === 'object') return raw;
+  try {
+    return JSON.parse(String(raw));
+  } catch {
+    return null;
+  }
+}
+
+function toRgb(color: string): RGB {
+  const hex = color.replace('#', '');
+  const full =
+    hex.length === 3
+      ? hex
+          .split('')
+          .map(c => c + c)
+          .join('')
+      : hex;
+  const n = parseInt(full, 16);
+  if (Number.isNaN(n) || full.length !== 6) return [200, 200, 200];
+  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+}
+
+function colorAt(colors: string[], t: number): string {
+  const clamped = Math.min(1, Math.max(0, t));
+  if (colors.length === 1) return colors[0];
+  const pos = clamped * (colors.length - 1);
+  const i = Math.min(colors.length - 2, Math.floor(pos));
+  const f = pos - i;
+  const a = toRgb(colors[i]);
+  const b = toRgb(colors[i + 1]);
+  const mix = a.map((v, k) => Math.round(v + (b[k] - v) * f));
+  return `rgb(${mix[0]},${mix[1]},${mix[2]})`;
+}
+
+export default function transformProps(
+  chartProps: EchartsLgaMapChartProps,
+): LgaMapChartTransformedProps {
+  const {
+    formData,
+    height,
+    hooks,
+    filterState,
+    queriesData,
+    width,
+    theme,
+    emitCrossFilters,
+  } = chartProps;
+  const data: DataRecord[] = queriesData[0]?.data || [];
+  const coltypeMapping = getColtypesMapping(queriesData[0] || {});
+  const {
+    groupby,
+    geomColumn,
+    lonColumn,
+    latColumn,
+    pointNameColumn,
+    metric = '',
+    numberFormat,
+    linearColorScheme,
+    showLabels,
+    showLegend,
+    showPoints,
+    areaStyle,
+    pointColor,
+    labelFontSize,
+    hideZeroCounts,
+    sliceId,
+  } = { ...DEFAULT_FORM_DATA, ...formData };
+
+  const refs: Refs = {};
+  const groupbyLabels = groupby.map(getColumnLabel);
+  const geomLabel = geomColumn ? getColumnLabel(geomColumn) : '';
+  const lonLabel = lonColumn ? getColumnLabel(lonColumn) : '';
+  const latLabel = latColumn ? getColumnLabel(latColumn) : '';
+  const pointNameLabel = pointNameColumn ? getColumnLabel(pointNameColumn) : '';
+  const metricLabel = getMetricLabel(metric);
+  const formatter = getNumberFormatter(numberFormat);
+  const { setDataMask = () => {}, onContextMenu } = hooks;
+
+  const features: GeoFeature[] = [];
+  const areaValues: Record<string, number> = {};
+  const areaNames: Record<string, string> = {};
+  const labelMap: Record<string, string[]> = {};
+  const points: { name: string; value: [number, number, number] }[] = [];
+  let maxValue = 0;
+  let maxPoint = 0;
+
+  data.forEach(datum => {
+    const value = Number(datum[metricLabel] ?? 0) || 0;
+    const geometry = parseGeometry(geomLabel ? datum[geomLabel] : null);
+    if (geometry) {
+      const key = extractGroupbyLabel({
+        datum,
+        groupby: groupbyLabels,
+        coltypeMapping: {},
+      });
+      if (!key) return;
+      maxValue = Math.max(maxValue, value);
+      features.push({ type: 'Feature', properties: { name: key }, geometry });
+      areaValues[key] = value;
+      areaNames[key] = cleanName(
+        String(datum[groupbyLabels[groupbyLabels.length - 1]] ?? key),
+      );
+      labelMap[key] = groupbyLabels.map(col => datum[col] as string);
+      return;
+    }
+    if (showPoints && lonLabel && latLabel) {
+      const lon = Number(datum[lonLabel]);
+      const lat = Number(datum[latLabel]);
+      if (
+        datum[lonLabel] === null ||
+        datum[latLabel] === null ||
+        !Number.isFinite(lon) ||
+        !Number.isFinite(lat)
+      ) {
+        return;
+      }
+      maxPoint = Math.max(maxPoint, value);
+      const lgaName = groupbyLabels.length
+        ? cleanName(String(datum[groupbyLabels[groupbyLabels.length - 1]] ?? ''))
+        : '';
+      const pointName = pointNameLabel
+        ? String(datum[pointNameLabel] ?? '')
+        : '';
+      points.push({
+        name: [pointName, lgaName].filter(Boolean).join(', '),
+        value: [lon, lat, value],
+      });
+    }
+  });
+
+  const mapName = `lga_map_${sliceId ?? 'preview'}`;
+  registerMap(mapName, { type: 'FeatureCollection', features } as never);
+
+  const scheme = linearColorScheme
+    ? getSequentialSchemeRegistry().get(linearColorScheme)
+    : undefined;
+  const colors = scheme?.colors?.length ? scheme.colors : FALLBACK_COLORS;
+
+  const shadeByCount = areaStyle === 'count';
+  const regions = Object.keys(areaValues).map(key => {
+    const value = areaValues[key];
+    return {
+      name: key,
+      itemStyle: {
+        areaColor: shadeByCount
+          ? colorAt(colors, maxValue > 0 ? value / maxValue : 0)
+          : areaStyle,
+      },
+      label: {
+        show: shadeByCount && showLabels && !(hideZeroCounts && value === 0),
+        formatter: `${areaNames[key]}\n${formatter(value)}`,
+      },
+    };
+  });
+
+  const legendGraphic = showLegend && shadeByCount
+    ? [
+        {
+          type: 'group',
+          left: 10,
+          bottom: 10,
+          children: [
+            {
+              type: 'rect',
+              shape: { x: 0, y: 0, width: 14, height: 90 },
+              style: {
+                fill: {
+                  type: 'linear',
+                  x: 0,
+                  y: 0,
+                  x2: 0,
+                  y2: 1,
+                  colorStops: colors
+                    .slice()
+                    .reverse()
+                    .map((c, i, arr) => ({
+                      offset: arr.length > 1 ? i / (arr.length - 1) : 0,
+                      color: c,
+                    })),
+                },
+                stroke: '#888888',
+                lineWidth: 0.5,
+              },
+            },
+            {
+              type: 'text',
+              style: {
+                x: 20,
+                y: 0,
+                text: formatter(maxValue),
+                fill: theme.colorText,
+                fontSize: 11,
+                textVerticalAlign: 'top',
+              },
+            },
+            {
+              type: 'text',
+              style: {
+                x: 20,
+                y: 90,
+                text: formatter(0),
+                fill: theme.colorText,
+                fontSize: 11,
+                textVerticalAlign: 'bottom',
+              },
+            },
+          ],
+        },
+      ]
+    : [];
+
+  const echartOptions: EChartsCoreOption = {
+    tooltip: {
+      trigger: 'item',
+      formatter: (params: { componentType?: string; name?: string }) => {
+        const key = String(params.name ?? '');
+        if (params.componentType === 'geo') {
+          const value = areaValues[key];
+          return `${sanitizeHtml(areaNames[key] ?? cleanName(key))}<br/>${sanitizeHtml(
+            metricLabel,
+          )}: ${formatter(Number.isFinite(value) ? value : 0)}`;
+        }
+        const point = points.find(p => p.name === key);
+        return `${sanitizeHtml(key)}<br/>${sanitizeHtml(metricLabel)}: ${formatter(
+          point ? point.value[2] : 0,
+        )}`;
+      },
+    },
+    graphic: legendGraphic,
+    geo: {
+      map: mapName,
+      nameProperty: 'name',
+      roam: true,
+      aspectScale: 0.99,
+      itemStyle: { areaColor: '#eeeeee', borderColor: '#555555', borderWidth: 0.6 },
+      label: {
+        show: false,
+        color: '#111111',
+        fontSize: labelFontSize,
+        lineHeight: labelFontSize + 2,
+      },
+      emphasis: {
+        label: { show: true, color: '#000000', fontWeight: 'bold' },
+        itemStyle: { borderColor: '#000000', borderWidth: 1.4 },
+      },
+      labelLayout: { hideOverlap: true },
+      regions,
+    },
+    series: showPoints
+      ? [
+          {
+            type: 'scatter',
+            coordinateSystem: 'geo',
+            data: points,
+            symbolSize: (value: number[]) =>
+              4 + 8 * Math.sqrt(maxPoint > 0 ? (value[2] || 0) / maxPoint : 0),
+            itemStyle: {
+              color: pointColor,
+              opacity: 0.85,
+              borderColor: '#ffffff',
+              borderWidth: 0.5,
+            },
+            emphasis: { scale: 1.6 },
+            zlevel: 2,
+          },
+        ]
+      : [],
+  };
+
+  return {
+    formData,
+    width,
+    height,
+    echartOptions,
+    setDataMask,
+    emitCrossFilters,
+    labelMap,
+    groupby,
+    selectedValues: {},
+    onContextMenu,
+    refs,
+    coltypeMapping,
+  };
+}
