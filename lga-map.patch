+import { t } from '@apache-superset/core/translation';
+import { Behavior } from '@superset-ui/core';
+import buildQuery from './buildQuery';
+import controlPanel from './controlPanel';
+import transformProps from './transformProps';
+import thumbnail from './images/thumbnail.png';
+import thumbnailDark from './images/thumbnail-dark.png';
+import example from './images/example.jpg';
+import exampleDark from './images/example-dark.jpg';
+import { EchartsLgaMapChartProps, EchartsLgaMapFormData } from './types';
+import { EchartsChartPlugin } from '../types';
+
+export default class EchartsLgaMapChartPlugin extends EchartsChartPlugin<
+  EchartsLgaMapFormData,
+  EchartsLgaMapChartProps
+> {
+  constructor() {
+    super({
+      buildQuery,
+      controlPanel,
+      loadChart: () => import('./EchartsLgaMap'),
+      metadata: {
+        behaviors: [Behavior.InteractiveChart, Behavior.DrillToDetail],
+        category: t('Map'),
+        credits: ['https://echarts.apache.org'],
+        description: t(
+          'Area map drawn from GeoJSON outlines stored in a dataset column. Each area is coloured by a metric and shows its name and count; clicking an area filters the dashboard.',
+        ),
+        exampleGallery: [{ url: example, urlDark: exampleDark }],
+        name: t('LGA Count Map'),
+        tags: [t('Geo'), t('ECharts'), t('Map'), t('Report')],
+        thumbnail,
+        thumbnailDark,
+      },
+      transformProps,
+    });
+  }
+}
diff --git a/superset-frontend/plugins/plugin-chart-echarts/src/LgaMap/transformProps.ts b/superset-frontend/plugins/plugin-chart-echarts/src/LgaMap/transformProps.ts
