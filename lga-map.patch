--- /dev/null
+++ b/Dockerfile.lga
@@ -0,0 +1,18 @@
+# Builds only the Superset frontend (with the LGA Count Map chart) and lays it
+# over the stock Superset image, so the Python side stays exactly as released.
+ARG BASE_IMAGE=apache/superset:6.1.0
+
+FROM node:22-trixie-slim AS fe
+ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
+    NODE_OPTIONS=--max_old_space_size=8192
+COPY docker/ /app/docker/
+RUN /app/docker/apt-install.sh build-essential python3 zstd
+WORKDIR /app/superset-frontend
+RUN mkdir -p /app/superset/static/assets /app/superset/translations
+COPY superset-frontend/package.json superset-frontend/package-lock.json ./
+RUN npm ci
+COPY superset-frontend /app/superset-frontend
+RUN npm run build
+
+FROM ${BASE_IMAGE}
+COPY --from=fe --chown=superset:superset /app/superset/static/assets /app/superset/static/assets
