+import { LgaMapChartTransformedProps } from './types';
+import Echart from '../components/Echart';
+import { allEventHandlers } from '../utils/eventHandlers';
+
+export default function EchartsLgaMap(props: LgaMapChartTransformedProps) {
+  const { height, width, echartOptions, selectedValues, refs, formData } =
+    props;
+
+  const allHandlers = allEventHandlers(props);
+  // Only clicks on an area filter the dashboard; clicks on dots are ignored.
+  const eventHandlers = {
+    ...allHandlers,
+    click: (params: { name: string; componentType?: string }) => {
+      if (params.componentType === 'geo') {
+        allHandlers.click?.(params as never);
+      }
+    },
+  };
+
+  return (
+    <Echart
+      refs={refs}
+      height={height}
+      width={width}
+      echartOptions={echartOptions}
+      eventHandlers={eventHandlers}
+      selectedValues={selectedValues}
+      vizType={formData.vizType}
+    />
+  );
+}
