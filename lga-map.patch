+import { t } from '@apache-superset/core/translation';
+import {
+  ControlPanelConfig,
+  D3_FORMAT_DOCS,
+  D3_FORMAT_OPTIONS,
+  D3_NUMBER_FORMAT_DESCRIPTION_VALUES_TEXT,
+  getStandardizedControls,
+  sharedControls,
+} from '@superset-ui/chart-controls';
+import { DEFAULT_FORM_DATA } from './types';
+
+const {
+  numberFormat,
+  showLabels,
+  showLegend,
+  labelFontSize,
+  hideZeroCounts,
+  showPoints,
+  areaStyle,
+  pointColor,
+} = DEFAULT_FORM_DATA;
+
+const config: ControlPanelConfig = {
+  controlPanelSections: [
+    {
+      label: t('Query'),
+      expanded: true,
+      controlSetRows: [
+        [
+          {
+            name: 'groupby',
+            config: {
+              ...sharedControls.groupby,
+              label: t('Area name column(s)'),
+              description: t(
+                'Column(s) that name each area, for example lga. Clicking an area filters the dashboard by these columns.',
+              ),
+            },
+          },
+        ],
+        [
+          {
+            name: 'geom_column',
+            config: {
+              ...sharedControls.entity,
+              label: t('GeoJSON geometry column'),
+              description: t(
+                'Column holding the area outline as GeoJSON text (Polygon or MultiPolygon).',
+              ),
+            },
+          },
+        ],
+        [
+          {
+            name: 'lon_column',
+            config: {
+              ...sharedControls.entity,
+              label: t('Point longitude column (optional)'),
+              description: t(
+                'Optional. Rows with a longitude and latitude are drawn as dots, for example settlements visited.',
+              ),
+            },
+          },
+        ],
+        [
+          {
+            name: 'lat_column',
+            config: {
+              ...sharedControls.entity,
+              label: t('Point latitude column (optional)'),
+            },
+          },
+        ],
+        [
+          {
+            name: 'point_name_column',
+            config: {
+              ...sharedControls.entity,
+              label: t('Point name column (optional)'),
+              description: t('Name shown when hovering over a dot.'),
+            },
+          },
+        ],
+        ['metric'],
+        ['adhoc_filters'],
+        [
+          {
+            name: 'row_limit',
+            config: {
+              ...sharedControls.row_limit,
+              default: 50000,
+            },
+          },
+        ],
+      ],
+    },
+    {
+      label: t('Chart Options'),
+      expanded: true,
+      controlSetRows: [
+        ['linear_color_scheme'],
+        [
+          {
+            name: 'number_format',
+            config: {
+              type: 'SelectControl',
+              freeForm: true,
+              label: t('Number format'),
+              renderTrigger: true,
+              default: numberFormat,
+              choices: D3_FORMAT_OPTIONS,
+              description: `${D3_FORMAT_DOCS} ${D3_NUMBER_FORMAT_DESCRIPTION_VALUES_TEXT}`,
+            },
+          },
+        ],
+        [
+          {
+            name: 'show_labels',
+            config: {
+              type: 'CheckboxControl',
+              label: t('Show name and count on each area'),
+              renderTrigger: true,
+              default: showLabels,
+              description: t('Print the area name and its count on the map.'),
+            },
+          },
+        ],
+        [
+          {
+            name: 'hide_zero_counts',
+            config: {
+              type: 'CheckboxControl',
+              label: t('Hide labels for areas with a zero count'),
+              renderTrigger: true,
+              default: hideZeroCounts,
+              description: t('Areas without data stay on the map without a label.'),
+            },
+          },
+        ],
+        [
+          {
+            name: 'label_font_size',
+            config: {
+              type: 'SelectControl',
+              freeForm: true,
+              label: t('Label font size'),
+              renderTrigger: true,
+              default: labelFontSize,
+              choices: [
+                [8, '8'],
+                [9, '9'],
+                [10, '10'],
+                [11, '11'],
+                [12, '12'],
+                [14, '14'],
+              ],
+              description: t('Font size of the labels, in pixels.'),
+            },
+          },
+        ],
+        [
+          {
+            name: 'area_style',
+            config: {
+              type: 'SelectControl',
+              label: t('Area fill'),
+              renderTrigger: true,
+              default: areaStyle,
+              clearable: false,
+              choices: [
+                ['count', t('Shade by metric (with counts)')],
+                ['#eef1f4', t('Light grey, no counts')],
+                ['#e3f2fd', t('Light blue, no counts')],
+                ['#fdf3e1', t('Light sand, no counts')],
+              ],
+              description: t(
+                'Shade each area by its metric and print counts, or draw plain neutral areas so dots stand out.',
+              ),
+            },
+          },
+        ],
+        [
+          {
+            name: 'point_color',
+            config: {
+              type: 'SelectControl',
+              label: t('Point colour'),
+              renderTrigger: true,
+              default: pointColor,
+              clearable: false,
+              choices: [
+                ['#d6336c', t('Pink')],
+                ['#f76707', t('Orange')],
+                ['#1c7ed6', t('Blue')],
+                ['#7048e8', t('Purple')],
+                ['#0ca678', t('Teal')],
+                ['#e03131', t('Red')],
+              ],
+            },
+          },
+        ],
+        [
+          {
+            name: 'show_points',
+            config: {
+              type: 'CheckboxControl',
+              label: t('Show points'),
+              renderTrigger: true,
+              default: showPoints,
+              description: t('Draw dots for rows that have a longitude and latitude.'),
+            },
+          },
+        ],
+        [
+          {
+            name: 'show_legend',
+            config: {
+              type: 'CheckboxControl',
+              label: t('Show colour scale'),
+              renderTrigger: true,
+              default: showLegend,
+              description: t('Show the colour scale in the corner of the map.'),
+            },
+          },
+        ],
+      ],
+    },
+  ],
+  formDataOverrides: formData => ({
+    ...formData,
+    metric: getStandardizedControls().shiftMetric(),
+    groupby: getStandardizedControls().popAllColumns(),
+  }),
+};
+
+export default config;
